{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://draftmaster.dev/schemas/sim-aggregate.schema.json",
  "title": "SimAggregate",
  "description": "The output of a Monte-Carlo run: one scenario simulated N times, reduced to a win-probability distribution and duration statistics, plus a representative stored SimResult for playback. Produced by the sim CLI --aggregate and served at POST /sims/aggregate.",
  "type": "object",
  "required": [
    "scenario",
    "runs",
    "radiant_win_rate",
    "duration_seconds",
    "duration_histogram",
    "representative_sim_id"
  ],
  "additionalProperties": false,
  "properties": {
    "scenario": {
      "description": "The draft that was simulated.",
      "$ref": "scenario.schema.json"
    },
    "runs": {
      "type": "integer",
      "description": "Number of simulations aggregated.",
      "minimum": 1
    },
    "radiant_win_rate": {
      "type": "number",
      "description": "Fraction of runs Radiant won.",
      "minimum": 0,
      "maximum": 1
    },
    "duration_seconds": {
      "title": "DurationStats",
      "type": "object",
      "description": "Game-length distribution across runs. The producer (montecarlo) always emits every field; required matches that.",
      "required": [
        "mean",
        "p25",
        "median",
        "p75"
      ],
      "additionalProperties": false,
      "properties": {
        "mean": {
          "type": "number"
        },
        "p25": {
          "type": "number"
        },
        "median": {
          "type": "number"
        },
        "p75": {
          "type": "number"
        }
      }
    },
    "duration_histogram": {
      "type": "array",
      "description": "Counts of games ending in each 5-minute bucket (for a chart).",
      "items": {
        "title": "DurationBucket",
        "type": "object",
        "required": [
          "minute",
          "count"
        ],
        "additionalProperties": false,
        "properties": {
          "minute": {
            "type": "integer",
            "description": "Lower edge of the 5-min bucket."
          },
          "count": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "representative_sim_id": {
      "type": "string",
      "description": "Id of a stored SimResult that typifies the aggregate, for playback."
    },
    "bracket": {
      "type": "string",
      "description": "Rank band whose hero ratings the sims used ('all' = blended across ranks).",
      "enum": [
        "all",
        "low",
        "mid",
        "high"
      ]
    }
  }
}
